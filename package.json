{
  "name": "reference-manager",
  "version": "1.0.0",
  "description": "本地文献管理系统",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && npm --prefix client run build",
    "build:server": "tsc",
    "build:client": "npm --prefix client run build",
    "start": "node dist/server.js",
    "dev": "tsc && node --watch dist/server.js",
    "dev:client": "npm --prefix client run dev",
    "test:parsers": "npm run build:server && node test-parsers.js",
    "test:integration": "npm run build:server && node integration-test.js",
    "test": "npm run test:parsers && npm run test:integration"
  },
  "keywords": ["reference", "bibliography", "latex", "bibtex"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.7",
    "typescript": "^5.3.3"
  }
}
